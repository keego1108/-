# このファイルを .env.local にコピーして値を設定してください。
# 未設定のままでも、モックデータ・デモOCRでアプリは動作します（決済機能を除く）。

# 写真からの食材読み取り（OCR）機能に使用。
# console.anthropic.com で発行できます。未設定の場合はサンプルデータで動作します。
ANTHROPIC_API_KEY=

# Supabaseプロジェクトの Project Settings > API から取得。
# 未設定の場合はブラウザ内のモックデータで動作します（サーバー再起動で消えます）。
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=

# Stripe（決済）。dashboard.stripe.com の 開発者 > APIキー から取得。
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# このアプリを公開するURL（Checkout/Portalの戻り先に使う）。開発中はlocalhostのままでOK。
NEXT_PUBLIC_APP_URL=http://localhost:3000
